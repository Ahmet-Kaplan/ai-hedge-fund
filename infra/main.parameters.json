{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": { "value": "aihf" },
    "location": { "value": "${AZURE_LOCATION}" },
    "fundName": { "value": "${FUND_NAME}" },
    "cronExpression": { "value": "${TICK_CRON=0 11 * * *}" },
    "llmModel": { "value": "${LLM_MODEL=azure/gpt-5-mini}" },
    "azureOpenAiEndpoint": { "value": "${AZURE_OPENAI_ENDPOINT}" },
    "azureOpenAiAccountName": { "value": "${AZURE_OPENAI_ACCOUNT_NAME=}" },
    "enableDashboard": { "value": true },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID=}" },
    "dashboardAllowedCidrs": { "value": "${DASHBOARD_ALLOWED_CIDRS=}" }
  }
}
