# Copy to ~/.hedge-fund/.env (or a .env in your working directory). The app
# also prompts for missing keys on first run and writes them there for you.
# Keys exported in your shell always win over these files.

# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# One LLM API key is enough — set the provider you plan to use.

# For running LLMs hosted by Anthropic (Opus, Sonnet, Haiku)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by OpenAI (GPT 5, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key
# Optional: OpenAI-compatible proxy (Groq, local gateway, Azure-style).
# OPENAI_API_BASE is accepted as an alias. Unlisted model ids use this
# transport when a base URL is set.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: bound every LLM HTTP/chat call, in seconds (default 60).
# LLM_REQUEST_TIMEOUT=60

# For running LLMs hosted by DeepSeek (deepseek-chat, deepseek-reasoner)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by Google (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For typed investor assessments with Jev — TypeSafe
# Get your TypeSafe API key from https://console.typesafe.ai/
# Select Jev in the model picker, or pass --model jev-1.13.0.
TYPESAFE_API_KEY=your-typesafe-api-key

# For running LLMs hosted by xAI (Grok 4, etc.)
XAI_API_KEY=your-xai-api-key

# Halt the scheduler daemon: new ticks become no-ops and the poll loop exits.
# A file at ~/.hedge-fund/KILL has the same effect (touch it to stop).
# HEDGE_FUND_KILL_SWITCH=1

# For running LLMs hosted by Moonshot / Kimi (kimi-k2, kimi-latest)
# Get your Moonshot API key from https://platform.moonshot.ai/
# Mainland China users: set MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key

# Local Ollama — no API key. Default host is http://127.0.0.1:11434.
# Model ids are Ollama tags (`ollama list`), e.g. llama3.1 or qwen2.5.
# Select one from the picker, pass --model llama3.1, or use ollama:<tag>
# for a pulled model that is not in the registry (ollama:mistral).
# A missing daemon fails inside LLM_REQUEST_TIMEOUT; it does not hang.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: cycle observability for the paper / live-clock path (and a
# future daemon). Events always log. Set a path to also append JSONL.
# HEDGE_FUND_EVENTS_PATH=~/.hedge-fund/observability/events.jsonl
# Heartbeat file the process updates each cycle. Enable with this path,
# HEDGE_FUND_HEARTBEAT=1 (default path), or `aihf … --heartbeat [PATH]`.
# HEDGE_FUND_HEARTBEAT_PATH=~/.hedge-fund/observability/heartbeat.json
# HEDGE_FUND_HEARTBEAT=1
# Optional: POST a JSON summary when a cycle fails. Webhook errors are
# logged and never swallow the original cycle exception. No live network
# is required to enable the heartbeat or event file.
# HEDGE_FUND_WEBHOOK_URL=
# HEDGE_FUND_WEBHOOK_TIMEOUT=5

# Optional: Alpaca as the execution venue (hedge_fund.brokers.AlpacaBroker).
# Needs the optional SDK: pip install alpaca-py
# Reads (cash, positions, market clock) always work. Order submission is
# gated in three layers so a stray variable cannot move real money:
#   ALPACA_PAPER=true                use the paper endpoint (default: true)
#   ALPACA_TRADING_ENABLED=1         required before ANY order is submitted
#   ALPACA_LIVE_TRADING_CONFIRMED=1  additionally required when PAPER is false
# ALPACA_API_SECRET is accepted as an alias for ALPACA_SECRET_KEY.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
# ALPACA_TRADING_ENABLED=0
# ALPACA_LIVE_TRADING_CONFIRMED=0
# Refuse to submit while the venue is closed (default). A market order sent
# outside hours is ACCEPTED and parked, but the pipeline reads positions back
# immediately — so the next cycle would re-issue the same trade. Set to 1 only
# if you intend to queue orders for the next open.
# ALPACA_ALLOW_CLOSED_MARKET=0

# Optional: pin the read-only dashboard's token across runs. Without it a
# token is generated per process and printed on startup. The dashboard is
# loopback-only and never submits orders.
# HEDGE_FUND_WEB_TOKEN=
